/* ==========================================================================
   Arrera Linux - Calamares Modern Dark / Arrera Blue Stylesheet
   ========================================================================== */

/* Fenêtre principale et conteneurs généraux */
QWidget {
    background-color: #0f172a;
    color: #f8fafc;
    font-family: "Cantarell", "Inter", "Segoe UI", "Noto Sans", sans-serif;
    font-size: 13px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QDialog, QMainWindow {
    background-color: #0f172a;
}

/* Barre latérale (Sidebar) */
#sidebarApp {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #0f172a,
                                stop:0.5 #172554,
                                stop:1 #0b1329);
    border-right: 1px solid #1e293b;
    min-width: 220px;
    padding: 16px 0px;
}

#sidebarWidget {
    background-color: transparent;
}

/* Éléments de la barre latérale */
#sidebarApp QLabel {
    color: #94a3b8;
    padding: 10px 18px;
    font-weight: 500;
}

#sidebarApp QLabel[selected=true] {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #2563eb,
                                stop:1 #3b82f6);
    border-left: 4px solid #60a5fa;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    font-weight: bold;
}

/* Conteneur de contenu principal */
#mainView {
    background-color: #0f172a;
}

/* Titres et labels */
QLabel {
    background-color: transparent;
    color: #f8fafc;
}

QLabel#titleLabel, QLabel#welcomeLabel {
    font-size: 20px;
    font-weight: bold;
    color: #60a5fa;
    margin-bottom: 8px;
}

QLabel#subTitleLabel {
    font-size: 14px;
    color: #94a3b8;
    margin-bottom: 16px;
}

/* Boutons (Action Buttons) */
QPushButton {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 8px 18px;
    min-height: 22px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #2e3d55;
    border-color: #3b82f6;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #1d4ed8;
    border-color: #2563eb;
}

QPushButton:disabled {
    background-color: #1e293b;
    color: #64748b;
    border-color: #1e293b;
}

/* Boutons d'action prioritaires (Suivant / Next) */
QPushButton#nextButton, QPushButton[primary=true] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #2563eb,
                                stop:1 #1d4ed8);
    border: 1px solid #3b82f6;
    color: #ffffff;
}

QPushButton#nextButton:hover, QPushButton[primary=true]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #3b82f6,
                                stop:1 #2563eb);
    border-color: #60a5fa;
}

/* Barre de progression */
QProgressBar {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    height: 22px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #2563eb,
                                stop:0.5 #3b82f6,
                                stop:1 #38bdf8);
    border-radius: 5px;
}

/* Champs de texte et entrées */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 8px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #3b82f6;
    background-color: #1e293b;
}

/* Listes, arbres et tableaux */
QListView, QTreeView, QTableView {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 6px;
    alternate-background-color: #172554;
    padding: 4px;
}

QListView::item, QTreeView::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListView::item:hover, QTreeView::item:hover {
    background-color: #2e3d55;
}

QListView::item:selected, QTreeView::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}

/* Menus déroulants (QComboBox) */
QComboBox {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #3b82f6;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #334155;
}

QComboBox QAbstractItemView {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #3b82f6;
    selection-background-color: #2563eb;
    padding: 4px;
}

/* Cases à cocher et boutons radio */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #f8fafc;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #475569;
    border-radius: 4px;
    background-color: #1e293b;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #3b82f6;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #2563eb;
    border-color: #3b82f6;
}

/* Barres de défilement (QScrollBar) */
QScrollBar:vertical {
    background: #0f172a;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #334155;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Tooltips */
QToolTip {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #3b82f6;
    border-radius: 4px;
    padding: 4px 8px;
}
