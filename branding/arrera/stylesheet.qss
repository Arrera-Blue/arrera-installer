/* ==========================================================================
   Arrera Blue 2026 - Thème Calamares GNOME / GTK 4 / Libadwaita Dark
   Fidèle aux spécifications de design GNOME 46+ et Libadwaita
   Palette officielle :
     - Fenêtre (@window_bg_color)       : #242424
     - Vue / Sidebar (@view_bg_color)    : #1e1e1e
     - Cartes (@card_bg_color)           : #2e2e2e
     - En-tête / Action (@headerbar_bg)  : #303030
     - Bordure subtile                   : rgba(255, 255, 255, 0.08)
     - Bordure forte                     : rgba(255, 255, 255, 0.14)
     - Texte principal                   : #ffffff
     - Texte secondaire (@dim_label)     : #9a9996
     - Accent GNOME Blue 3               : #3584e4
     - Accent Survol GNOME Blue 2        : #4894f6
     - Accent Actif GNOME Blue 4         : #2672d4
     - Destructif (Rouge Adwaita)        : #c01c28 / #e01b24
     - Succès (Vert Adwaita)             : #2ec27e
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. Base globale & Typographie GNOME Cantarell
   -------------------------------------------------------------------------- */
QWidget {
    background-color: #242424;
    color: #ffffff;
    font-family: "Adwaita Sans", "Cantarell", "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
    selection-background-color: #3584e4;
    selection-color: #ffffff;
    outline: none;
}

QMainWindow, QDialog {
    background-color: #242424;
    color: #ffffff;
}

/* Zone centrale d'affichage des étapes Calamares */
#mainView, #viewManager, QStackedWidget {
    background-color: #242424;
    border: none;
}

/* --------------------------------------------------------------------------
   2. Barre latérale (Style AdwNavigationSplitView)
   -------------------------------------------------------------------------- */
#sidebarApp {
    background-color: #1e1e1e;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    min-width: 240px;
    max-width: 260px;
    padding: 16px 0px;
}

#sidebarWidget {
    background-color: transparent;
    border: none;
}

/* Logo de marque en haut de la barre latérale */
#logoLabel {
    padding: 16px 20px 24px 20px;
    background-color: transparent;
}

/* Libellés des étapes dans la barre latérale (Pillules Libadwaita) */
#sidebarApp QLabel {
    color: #9a9996;
    padding: 10px 18px;
    margin: 3px 12px;
    font-size: 13px;
    font-weight: 500;
    border-radius: 8px;
    background-color: transparent;
}

/* Survol étape non sélectionnée */
#sidebarApp QLabel:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.06);
}

/* Étape active / courante (Pillule bleue Libadwaita @accent_bg_color) */
#sidebarApp QLabel[selected=true] {
    color: #ffffff;
    background-color: #3584e4;
    font-weight: 600;
    border-radius: 8px;
}

/* Boutons utilitaires en bas de la sidebar (À propos, Journal de débogage) */
#sidebarApp QPushButton {
    background-color: rgba(255, 255, 255, 0.08);
    color: #c0bfbc;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 500;
    min-height: 22px;
    margin: 4px 12px;
}

#sidebarApp QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.12);
}

#sidebarApp QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.2);
}

/* --------------------------------------------------------------------------
   3. Barre d'action inférieure (Navigation / AdwBottomBar)
   -------------------------------------------------------------------------- */
#navigationWidget {
    background-color: #242424;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 14px 24px;
    min-height: 48px;
}

/* Boutons standards (AdwButton - Pilules plates Libadwaita) */
QPushButton {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 8px 22px;
    min-height: 26px;
    min-width: 80px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.1);
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.22);
}

QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.3);
    border-color: transparent;
}

/* Bouton d'action suggérée (Suivant / Installer - .suggested-action Libadwaita) */
QPushButton#nextButton, QPushButton[primary=true] {
    background-color: #3584e4;
    border: none;
    color: #ffffff;
    font-weight: 700;
}

QPushButton#nextButton:hover, QPushButton[primary=true]:hover {
    background-color: #4894f6;
}

QPushButton#nextButton:pressed, QPushButton[primary=true]:pressed {
    background-color: #2672d4;
}

QPushButton#nextButton:disabled, QPushButton[primary=true]:disabled {
    background-color: rgba(53, 132, 228, 0.35);
    color: rgba(255, 255, 255, 0.4);
}

/* Bouton d'annulation (Action destructive douce) */
QPushButton#cancelButton {
    background-color: rgba(255, 255, 255, 0.08);
}

QPushButton#cancelButton:hover {
    background-color: rgba(224, 27, 36, 0.18);
    border: 1px solid rgba(224, 27, 36, 0.45);
    color: #f66151;
}

QPushButton#cancelButton:pressed {
    background-color: #c01c28;
    color: #ffffff;
}

/* --------------------------------------------------------------------------
   4. Typographie, Titres et Sous-titres (Libadwaita Heading)
   -------------------------------------------------------------------------- */
QLabel {
    background-color: transparent;
    color: #ffffff;
}

QLabel#titleLabel, QLabel#welcomeLabel, QLabel#headerLabel {
    font-size: 22px;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 6px;
    letter-spacing: -0.3px;
}

QLabel#subTitleLabel {
    font-size: 14px;
    color: #9a9996;
    margin-bottom: 18px;
}

QLabel#explanationLabel, QLabel#descLabel {
    font-size: 13px;
    color: #deddda;
    line-height: 1.4;
}

/* --------------------------------------------------------------------------
   5. Cartes & Listes groupées (Libadwaita Boxed Lists & Cards)
   -------------------------------------------------------------------------- */
QGroupBox {
    background-color: #2e2e2e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    margin-top: 24px;
    padding: 16px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 4px;
    padding: 0 6px;
    color: #9a9996;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
}

#requirementsBox, QFrame#requirementsBox, QWidget#requirementsWidget {
    background-color: #2e2e2e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 16px;
    margin: 10px 0px;
}

#requirementsBox QLabel {
    font-size: 13px;
    padding: 6px 0px;
}

/* --------------------------------------------------------------------------
   6. Menus déroulants (Sélecteurs de langue, fuseaux - Style AdwComboRow)
   -------------------------------------------------------------------------- */
QComboBox {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 8px 14px;
    min-height: 24px;
    font-weight: 500;
}

QComboBox:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.14);
}

QComboBox:focus {
    border: 2px solid #3584e4;
    padding: 7px 13px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: #2e2e2e;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    selection-background-color: #3584e4;
    selection-color: #ffffff;
    padding: 6px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 6px;
    margin: 1px 0px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QComboBox QAbstractItemView::item:selected {
    background-color: #3584e4;
    color: #ffffff;
}

/* --------------------------------------------------------------------------
   7. Champs de saisie (AdwEntryRow)
   -------------------------------------------------------------------------- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: rgba(255, 255, 255, 0.07);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 9px 14px;
    selection-background-color: #3584e4;
    selection-color: #ffffff;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(255, 255, 255, 0.09);
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #3584e4;
    background-color: rgba(255, 255, 255, 0.12);
    padding: 8px 13px;
}

/* --------------------------------------------------------------------------
   8. Listes, Arborescences & Tableaux (Boxed Lists Adwaita)
   -------------------------------------------------------------------------- */
QListView, QTreeView, QTableView {
    background-color: #2e2e2e;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    alternate-background-color: #282828;
    padding: 6px;
    outline: none;
}

QListView::item, QTreeView::item {
    padding: 10px 14px;
    border-radius: 8px;
    margin: 2px 0px;
    color: #deddda;
}

QListView::item:hover, QTreeView::item:hover {
    background-color: rgba(255, 255, 255, 0.07);
    color: #ffffff;
}

QListView::item:selected, QTreeView::item:selected {
    background-color: #3584e4;
    color: #ffffff;
    font-weight: 600;
}

QHeaderView::section {
    background-color: #1e1e1e;
    color: #9a9996;
    padding: 8px 14px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-weight: 600;
}

/* --------------------------------------------------------------------------
   9. Cases à cocher et Boutons Radio (GTK 4 Toggles)
   -------------------------------------------------------------------------- */
QCheckBox, QRadioButton {
    spacing: 12px;
    color: #ffffff;
    font-weight: 500;
    padding: 4px 0px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.08);
}

QRadioButton::indicator {
    border-radius: 10px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #3584e4;
    background-color: rgba(255, 255, 255, 0.14);
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #3584e4;
    border-color: #3584e4;
}

/* --------------------------------------------------------------------------
   10. Cartes de choix de partitionnement (Style AdwActionRow interactif)
   -------------------------------------------------------------------------- */
ChoicePage, QWidget#ChoicePage {
    background-color: #242424;
}

ChoicePage QRadioButton {
    background-color: #2e2e2e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 14px 18px;
    margin: 6px 0px;
    font-size: 14px;
    font-weight: 600;
}

ChoicePage QRadioButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.16);
}

ChoicePage QRadioButton:checked {
    border: 2px solid #3584e4;
    background-color: rgba(53, 132, 228, 0.12);
}

/* --------------------------------------------------------------------------
   11. Barre de progression (AdwProgressBar mince et plate)
   -------------------------------------------------------------------------- */
QProgressBar {
    background-color: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
    font-weight: 600;
    height: 8px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar::chunk {
    background-color: #3584e4;
    border-radius: 4px;
}

/* --------------------------------------------------------------------------
   12. Barres de défilement (Scrollbars fines flottantes GNOME)
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.22);
    min-height: 32px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.45);
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.22);
    min-width: 32px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.45);
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;
    width: 0px;
    border: none;
}

/* --------------------------------------------------------------------------
   13. Onglets (AdwViewSwitcher - Style Pilules)
   -------------------------------------------------------------------------- */
QTabBar::tab {
    background-color: transparent;
    color: #9a9996;
    padding: 8px 18px;
    border-radius: 8px;
    margin: 3px 4px;
    font-weight: 500;
}

QTabBar::tab:hover:!selected {
    background-color: rgba(255, 255, 255, 0.06);
    color: #ffffff;
}

QTabBar::tab:selected {
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-weight: 600;
}

/* --------------------------------------------------------------------------
   14. Curseur & Sliders (AdwScale)
   -------------------------------------------------------------------------- */
QSlider::groove:horizontal {
    height: 6px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #3584e4;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.2);
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #f6f5f4;
}

/* --------------------------------------------------------------------------
   15. Boîtes de dialogue, Infobulles et Menus contextuels (AdwDialog / Popover)
   -------------------------------------------------------------------------- */
QDialog, QMessageBox {
    background-color: #2e2e2e;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
}

QToolTip {
    background-color: #2e2e2e;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

QMenu {
    background-color: #2e2e2e;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #3584e4;
    color: #ffffff;
}

/* --------------------------------------------------------------------------
   16. Page de sélection du mode d'installation (PackageChooser)
   -------------------------------------------------------------------------- */
#packageChooserPage, QWidget#PackageChooserPage {
    background-color: #242424;
}

#packageChooserPage QListView {
    background-color: #2e2e2e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 8px;
    min-width: 270px;
    font-size: 13px;
}

#packageChooserPage QListView::item {
    padding: 12px 16px;
    border-radius: 8px;
    margin: 4px 0px;
    color: #deddda;
    font-weight: 500;
}

#packageChooserPage QListView::item:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

#packageChooserPage QListView::item:selected {
    background-color: #3584e4;
    color: #ffffff;
    font-weight: 700;
}

#packageChooserPage QLabel#previewLabel,
#packageChooserPage QLabel#screenshotLabel,
#packageChooserPage QScrollArea {
    background-color: transparent;
    border: none;
}

#packageChooserPage QLabel#descriptionLabel {
    color: #9a9996;
    font-size: 13px;
    padding: 10px;
}

/* --------------------------------------------------------------------------
   17. Page de création d'utilisateur (UsersPage)
   -------------------------------------------------------------------------- */
QLabel#passwordMismatchLabel, QLabel#passwordErrorLabel {
    color: #f66151;
    font-weight: 600;
    font-size: 12px;
}

/* --------------------------------------------------------------------------
   18. Page de résumé (SummaryPage) & Page de fin (FinishedPage)
   -------------------------------------------------------------------------- */
#summaryPage, QWidget#SummaryPage {
    background-color: #242424;
}

#summaryWidget, #summaryTextBrowser {
    background-color: #2e2e2e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 12px;
    color: #deddda;
}

#finishedPage, QWidget#FinishedPage {
    background-color: #242424;
}

#finishedPage QLabel#finishedText {
    font-size: 14px;
    color: #deddda;
    line-height: 1.5;
}
