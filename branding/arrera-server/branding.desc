---
componentName:  arrera-server

### WELCOME / OVERALL WORDING
welcomeStyleCalamares:   false
welcomeExpandingLogo:    true

### WINDOW CONFIGURATION
windowExpanding:    normal
windowSize:         1060px,680px
windowPlacement:    center

### PANELS CONFIGURATION
sidebar:    widget
navigation: widget

### STRINGS, IMAGES AND COLORS
strings:
    productName:         "Arrera Blue Édition Serveur"
    version:             "2026"
    shortVersion:        "2026"
    shortProductName:    "Arrera Blue Serveur"
    versionedName:       "Arrera Blue Édition Serveur 2026"
    shortVersionedName:  "Arrera Blue Serveur 2026"
    bootloaderEntryName: "Arrera Blue Edition Serveur"
    productUrl:          "https://github.com/Arrera-Software"
    supportUrl:          "https://github.com/Arrera-Software"
    knownIssuesUrl:      "https://github.com/Arrera-Software"
    releaseNotesUrl:     "https://github.com/Arrera-Software"
    donateUrl:           ""

images:
    productLogo:         "arrera-logo.png"
    productIcon:         "arrera-logo.png"
    productWelcome:      "arrera-logo.svg"

### SLIDESHOW
slideshow:     "slideshow.qml"
slideshowAPI:  2

### SIDEBAR COLORS (Palette GNOME Libadwaita Light - Accent Black)
style:
    SidebarBackground:        "#ebebeb"
    SidebarBackgroundCurrent: "#303030"
    SidebarText:              "#5e5c64"
    SidebarTextCurrent:       "#ffffff"
