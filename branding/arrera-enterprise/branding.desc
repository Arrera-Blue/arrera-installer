---
componentName:  arrera-enterprise

### WELCOME / OVERALL WORDING
welcomeStyleCalamares:   false
welcomeExpandingLogo:    true

### WINDOW CONFIGURATION
windowExpanding:    normal
windowSize:         1060px,680px
windowPlacement:    center

### PANELS CONFIGURATION
sidebar:    widget
navigation: widget

### STRINGS, IMAGES AND COLORS
strings:
    productName:         "Arrera Blue Édition Entreprise"
    version:             "2026"
    shortVersion:        "2026"
    shortProductName:    "Arrera Blue Entreprise"
    versionedName:       "Arrera Blue Édition Entreprise 2026"
    shortVersionedName:  "Arrera Blue Entreprise 2026"
    bootloaderEntryName: "Arrera Blue Edition Entreprise"
    productUrl:          "https://github.com/Arrera-Software"
    supportUrl:          "https://github.com/Arrera-Software"
    knownIssuesUrl:      "https://github.com/Arrera-Software"
    releaseNotesUrl:     "https://github.com/Arrera-Software"
    donateUrl:           ""

images:
    productLogo:         "arrera-logo.png"
    productIcon:         "arrera-logo.png"
    productWelcome:      "arrera-logo.svg"

### SLIDESHOW
slideshow:     "slideshow.qml"
slideshowAPI:  2

### SIDEBAR COLORS (Palette GNOME Libadwaita Light - Accent Purple)
style:
    SidebarBackground:        "#ebebeb"
    SidebarBackgroundCurrent: "#9141ac"
    SidebarText:              "#5e5c64"
    SidebarTextCurrent:       "#ffffff"
